# Supply only the keys required by the chosen provider. Never commit real keys.
AI_PROVIDER=openai
DAILY_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(36))"
ACCESS_PASSWORD=

OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
BOT_VOICE=alloy
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Charon
GROK_MODEL=grok-voice-latest
GROK_VOICE=eve
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# For AI_PROVIDER=ollama, use a host reachable from Railway. Not your laptop's localhost.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Text providers need speech recognition and synthesis. Empty means OpenRouter
# speech for AI_PROVIDER=openrouter, or OpenAI speech for AI_PROVIDER=ollama.
SPEECH_PROVIDER=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=af_heart
OPENROUTER_TTS_SAMPLE_RATE=24000
BOT_PROMPT=You are a helpful AI voice assistant. Speak naturally and keep answers brief unless asked for detail. Be clear that you are an AI. Do not claim to perform actions or access information you cannot access.
MAX_SESSION_SECONDS=600
PORT=8080
